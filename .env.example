# 引导配置(唯一允许放环境变量的部分)。其余全部走 Nacos 配置中心。
# 复制为 .env 使用:cp .env.example .env

# 地址一律写服务名(nacos / mysql / redis),本机进程和容器用同一套写法。
# 本机要能解析这些名字,在 /etc/hosts 里加一行:
#   127.0.0.1  nacos mysql redis
NACOS_SERVER=nacos:8848
# 命名空间 ID(不是名称),默认 prod。留空 = public。
#
# 容器不读这个文件(.dockerignore 里排除了),docker-compose.yml 里写的是
# ${NACOS_NAMESPACE:-prod}:起容器一定是 prod,不会被这里改成别的。
# 本机调试想跟生产配置隔开,就把这里清空走 public。
#
# prod 命名空间要先建好:python3 dev.py nacos-namespace prod
NACOS_NAMESPACE=prod
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# 共享中间件发布到宿主机的端口。只影响本地进程调试和 python3 dev.py check;
# 容器内一律走容器端口(mysql:3306 / redis:6379),不看这里。
# 实际值以 infra 目录的 .env 为准(比如本机 6379 被原生 redis 占了就会让到 6380)。
INFRA_DB_PORT=3306
INFRA_REDIS_PORT=6379

# DBA/迁移专用:有 DDL 权限的账号,只给 alembic 建表/改表用(python3 dev.py db-upgrade)。
# 应用运行时连库用的是 Nacos 里 cmdb-service.yaml 的 db.dsn(只有 DML 权限的 cmdb_app 账号),
# 两者权限分离是故意的,不要把这个账号配进 Nacos 或应用代码里。
CMDB_MIGRATOR_DATABASE_URL=mysql+pymysql://root:root@mysql:3306/cmdb

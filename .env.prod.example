# 生产环境的覆盖值。命名空间不用写在这——docker-compose.yml 已经把容器固定在
# prod 命名空间了("起容器就是生产")。这份只在两种情况下需要:
#
#   1. 生产的 Nacos 凭据跟开发不同:
#        docker compose --env-file .env.prod up -d
#   2. 对生产库跑迁移(本机进程,不是容器):
#        ENV_FILE=.env.prod python3 dev.py db-upgrade
#
# 用法: cp .env.prod.example .env.prod  然后改掉 CHANGE-ME

NACOS_SERVER=nacos:8848
NACOS_NAMESPACE=prod
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=nacos
NACOS_PASSWORD=CHANGE-ME

# 只给本机进程用(本地调试和迁移任务),容器不读——容器内走服务名
INFRA_DB_PORT=3306
INFRA_REDIS_PORT=6379
CMDB_MIGRATOR_DATABASE_URL=mysql+pymysql://root:CHANGE-ME@mysql:3306/cmdb

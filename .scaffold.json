{
  "project_name": "cmdb",
  "description": "服务器管理基础模块",
  "python_version": "3.12",
  "service": "cmdb",
  "proto_pkg": "cmdb",
  "proto_version": "v1",
  "proto_deps": "auth/v1",
  "with_contracts": true,
  "contracts_dir": "../contracts",
  "with_gateway": true,
  "gateway_port": 0,
  "with_demo": false,
  "database": "mysql",
  "db_name": "cmdb",
  "db_user": "cmdb_app",
  "db_password": "cmdb_app",
  "redis_db": 0,
  "with_alembic": true,
  "with_redis": true,
  "with_docker": true,
  "with_buf": true,
  "shared_middleware": true,
  "infra_network": "devops-net",
  "nacos_server": "nacos:8848",
  "nacos_group": "DEFAULT_GROUP",
  "nacos_namespace": "prod"
}
